{
  "name": "fylo-firestore-tests",
  "version": "1.0.0",
  "description": "Firestore Rules Tests for Fylo",
  "scripts": {
    "test": "jest test/firestore.rules.test.js --testTimeout=30000",
    "test:rules": "firebase emulators:exec --only firestore 'npm test'",
    "emulators": "firebase emulators:start --only firestore"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "firebase-admin": "^12.0.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "verbose": true
  }
}
